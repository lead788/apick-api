{
  "name": "apick-api",
  "version": "2.0.0",
  "description": "Official zero-dependency Node.js client for 25 APICK APIs. 에이픽 주요 API 25개를 간편하게 호출하는 공식 Node.js SDK.",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "files": [
    "src",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
	"test": "node --test && npm run test:types",
	"test:types": "tsc -p tsconfig.json",
	"test:coverage": "node --test --experimental-test-coverage",
	"prepublishOnly": "npm test"
  },
	"devDependencies": {
		"typescript": "^7.0.2"
	},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lead788/apick-api.git"
  },
  "bugs": {
    "url": "https://github.com/lead788/apick-api/issues"
  },
  "homepage": "https://apick.app/dev_guide",
  "license": "MIT",
  "author": "APICK",
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "keywords": [
    "apick",
    "api",
    "sdk",
    "korea",
    "korean-api",
    "business-registry",
    "parcel-tracking",
    "address",
    "ocr",
    "whois",
    "dns",
    "google-search",
    "pdf",
    "excel",
    "tts-jobs",
    "text-summary"
  ]
}
